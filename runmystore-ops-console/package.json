{
  "name": "rms-ops-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:reset": "scripts/local/db.sh reset",
    "db:local:test": "scripts/local/db.sh test",
    "functions:test": "cd supabase/functions && ../../node_modules/.bin/deno test --allow-net --allow-env --allow-read .",
    "functions:local": "cd supabase/functions && ../../node_modules/.bin/deno run --allow-net --allow-env --allow-read _shared/local-stack.ts",
    "simulate": "tsx scripts/simulate.ts",
    "import": "tsx scripts/import-events.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "deno": "^2.9.6",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
